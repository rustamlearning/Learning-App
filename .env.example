# Supabase frontend config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side AI config for api/ai.js
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_REQUIRE_AUTH=true
AI_RATE_LIMIT_MAX=24
AI_TIMEOUT_MS=22000
AI_MAX_PROMPT_CHARS=6000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional OpenRouter fallback, disabled by default
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=IsleLearn App
